# Copy to .env and fill in real values. Never commit .env.
AUTO_DEV_API_KEY=your_auto_dev_key_here

# ---- LLM: pick ONE option (any OpenAI-compatible endpoint works) ----

# Option A: Groq (free tier, no credit card, very fast). Key: https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=your_groq_key_here
# Faster, slightly less capable:
# LLM_MODEL=openai/gpt-oss-20b
# Groq's lineup changes. List what your key can use with:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $LLM_API_KEY"
# Reasoning models (gpt-oss, Qwen3) think before answering; keep that short:
LLM_REASONING_EFFORT=low

# Option B: Ollama (100% local and free, no key, no internet needed for the model)
#   1) Install from https://ollama.com   2) ollama pull llama3.1:8b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
# LLM_API_KEY=
# (remove LLM_REASONING_EFFORT above if your local model doesn't support it)

# Optional: seconds to wait for the LLM (default 60)
LLM_TIMEOUT_SECONDS=60